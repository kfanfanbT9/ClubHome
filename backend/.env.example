# 색연필 백엔드 환경변수 예시 — 실제 값은 .env에만 두고 저장소에 커밋하지 않는다.
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채운다.

# PostgreSQL 접속 문자열 (postgresql://사용자:비밀번호@호스트:포트/DB이름)
DATABASE_URL=

# JWT 서명 시크릿 — Access/Refresh를 서로 다른 값으로 설정한다
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# JWT 유효기간 (jsonwebtoken expiresIn 형식, 예: 1h / 14d)
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# 서버 포트
PORT=

# CORS 허용 origin. 쉼표로 여러 개를 적을 수 있다(정확히 일치하는 origin만 허용).
# 예: CORS_ORIGIN=http://localhost:5173,https://clubhome.example.com
# 미설정이면 교차 출처 요청을 전혀 허용하지 않는다. 와일드카드 '*'는 지원하지 않는다.
# 프론트엔드를 별도 포트/도메인에서 띄우면(Vite 기본 5173) 반드시 채워야 한다.
CORS_ORIGIN=

# API 문서(Swagger UI) 공개 여부. 'true'일 때만 GET /api-docs·/swagger.yaml 이 열린다.
# 미설정·빈 값·그 외 모든 값은 "끔"으로 취급된다(명시적으로 켜야 열리는 기본 안전값).
# 이 두 경로에는 인증이 없다 — 외부에 공개된 서버에서는 켜지 말 것.
ENABLE_API_DOCS=

# 콘솔 로그 레벨 (선택. silent / error / warn / info, 미설정 시 info)
# info=요청 한 줄씩 + 기동, warn=거부·롤백만, error=서버 오류만, silent=끔.
# 값을 비워두면 미설정과 같게 취급되어 기본값 info가 쓰인다.
LOG_LEVEL=

# 테스트 전용 DB 접속 문자열은 .env.test 에 DATABASE_URL 한 줄로 둔다(git 미포함).
# `npm run test:db` 가 .env 의 DATABASE_URL 에서 DB 이름만 바꿔 자동 생성한다.
